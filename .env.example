# Sao chép file này thành .env.local khi chạy trên máy, và khai báo các biến tương tự trên Vercel
# (Project Settings > Environment Variables).

# Form liên hệ: API key của Resend (https://resend.com) để tin nhắn gửi thẳng về email của bạn.
# Để trống thì nút "Send message" sẽ mở ứng dụng email của người xem với nội dung đã điền sẵn.
# Chỉ dùng ở server, không lộ ra trình duyệt.
RESEND_API_KEY=

# Tùy chọn: email nhận tin. Để trống thì gửi về email ghi trong src/data/profile.ts.
# Lưu ý: khi chưa xác minh tên miền trên Resend, chỉ gửi được tới email bạn dùng để đăng ký Resend.
CONTACT_TO_EMAIL=

# Tùy chọn: địa chỉ gửi đi, chỉ đặt sau khi đã xác minh tên miền trên Resend (xem README,
# mục "Để email không vào Spam"), ví dụ: Duy An Portfolio <contact@feb20th.click>.
# Để trống thì dùng onboarding@resend.dev (dễ bị Gmail cho vào Spam).
CONTACT_FROM_EMAIL=

# Trợ lý AI hỏi đáp về bạn (nút "Hỏi AI" và lệnh ask trong Terminal): API key Google Gemini, miễn phí,
# lấy ở https://aistudio.google.com/apikey (xem README, mục "Trợ lý AI"). Để trống thì khung chat báo trợ lý chưa bật.
# Chỉ dùng ở server, không lộ ra trình duyệt.
GEMINI_API_KEY=

# Tùy chọn: model chính cho trợ lý. Để trống là gemini-3.5-flash-lite (khoảng 500 câu/ngày ở gói Free).
GEMINI_MODEL=

# Tùy chọn: tên miền riêng của bạn, ví dụ https://feb20th.click
# Để trống thì trên Vercel sẽ tự dùng tên miền chính của dự án.
NEXT_PUBLIC_SITE_URL=

# Tùy chọn: token GitHub (fine-grained, chỉ đọc) cho mục "Hoạt động GitHub".
# Không bắt buộc, chỉ cần khi GitHub giới hạn lượt gọi. Chỉ dùng ở server.
GITHUB_TOKEN=
