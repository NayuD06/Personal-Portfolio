# Sao chép file này thành .env.local khi chạy trên máy, và khai báo các biến tương tự trên Vercel
# (Project Settings > Environment Variables).

# Tùy chọn: ID form Formspree để form liên hệ gửi thẳng về email (https://formspree.io).
# Để trống thì nút "Send message" sẽ mở ứng dụng email với nội dung đã điền sẵn.
NEXT_PUBLIC_FORMSPREE_ID=

# Tùy chọn: tên miền riêng của bạn, ví dụ https://duyan.dev
# Để trống thì trên Vercel sẽ tự dùng địa chỉ *.vercel.app.
NEXT_PUBLIC_SITE_URL=

# Tùy chọn: token GitHub (fine-grained, chỉ đọc) cho mục "Hoạt động GitHub".
# Không bắt buộc, chỉ cần khi GitHub giới hạn lượt gọi. Chỉ dùng ở server.
GITHUB_TOKEN=
